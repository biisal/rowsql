          {
            "explode": false,
            "in": "query",
            "name": "column",
            "schema": {
              "type": "string"
            }
          },
          {
            "explode": false,
            "in": "query",
            "name": "order",
            "schema": {
              "enum": ["ASC", "DESC"],

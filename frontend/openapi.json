            "items": {
              "$ref": "#/components/schemas/VarianDataType"
            },
            "type": ["array", "null"]
          },
          "stringType": {
            "items": {
              "$ref": "#/components/schemas/VarianDataType"
            },
            "type": ["array", "null"]
          }
        },
        "required": ["numericType", "stringType"],
        "type": "object"
      },

            "type": "boolean"
          },
          "page": {
            "format": "int64",
            "type": "integer"
          },
          "rowCount": {
            "format": "int64",
            "type": "integer"
          },
          "rows": {
            "items": {
              "$ref": "#/components/schemas/RowSet"
            },
            "type": ["array", "null"]
          },
          "totalPages": {
            "format": "int64",
            "type": "integer"
          }

        "required": [
          "page",
          "rows",
          "cols",
          "rowCount",
          "activeTable",
          "hasNextPage",
          "totalPages"
        ],
        "type": "object"
      },
      "ListTablesRow": {
        "additionalProperties": true,
        "properties": {
          "tableName": {
            "type": "string"
          },
          "tableSchema": {
            "type": "string"
          }
        },
        "required": ["tableSchema", "tableName"],
        "type": "object"
      },
      "RowInsertOrUpdateFormOutputBody": {
        "additionalProperties": true,
        "properties": {
          "$schema": {
            "description": "A URL to the JSON Schema for this object.",
            "examples": [
              "https://example.com/schemas/RowInsertOrUpdateFormOutputBody.json"
            ],
            "format": "uri",
            "readOnly": true,
            "type": "string"
          },

{
  "components": {
    "schemas": {
      "ColType": {
        "additionalProperties": true,
        "properties": {
          "dataType": {
            "type": "string"
          },
          "hasAutoIncrement": {
            "type": "boolean"
          },
          "hasDefault": {
            "type": "boolean"
          },
          "hasDigit": {
            "type": "boolean"
          },
          "hasSize": {
            "type": "boolean"
          },
          "hasValues": {
            "type": "boolean"
          },
          "inputType": {
            "enum": [
              "text",
              "number",
              "checkbox",
              "textarea",
              "json",
              "select"
            ],
            "type": "string"
          },
          "isNull": {
            "type": "boolean"
          },
          "isPk": {
            "type": "boolean"
          },
          "isUnique": {
            "type": "boolean"
          }
        },
        "required": [
          "dataType",
          "hasSize",
          "hasAutoIncrement",
          "hasDefault",
          "isUnique",
          "isPk",
          "isNull",
          "inputType"
